<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BlueMeter</AssemblyName>
    <RootNamespace>BlueMeter</RootNamespace>
    <Version>1.5.6</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Sets the .exe file icon (Windows Explorer, taskbar, alt-tab). Points at the
      shared asset in BlueMeter.Assets — same icon Phase 11 removed from the old
      WPF project. Per-window title-bar icons are set through Window.Icon bindings
      in App.axaml.cs so that every opened Window (including frameless ones with
      SystemDecorations="None") gets the taskbar glyph.
    -->
    <ApplicationIcon>..\BlueMeter.Assets\Images\ApplicationIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Xaml.Behaviors" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Observable" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Tesseract" />
    <PackageReference Include="OxyPlot.Core" />
    <PackageReference Include="OxyPlot.Avalonia" />
    <PackageReference Include="Ihon.ResXKeyCodeGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <ClassNamePostfix>Keys</ClassNamePostfix>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-CN.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.pt-BR.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!--
      Queue-pop alert sounds. SoundPlayerService plays these through the Win32
      MCI API (`mciSendString open <path> type mpegvideo`), which reads from the
      filesystem — it cannot consume avares:// resources. Copy the files next
      to the .exe under Assets\sounds\ so GetSoundFilePath() resolves them
      relative to AppDomain.CurrentDomain.BaseDirectory.
    -->
    <Content Include="..\BlueMeter.Assets\sounds\**\*.mp3" Link="Assets\sounds\%(RecursiveDir)%(FileName)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueMeter.Core\BlueMeter.Core.csproj" />
    <ProjectReference Include="..\BlueMeter.Assets\BlueMeter.Assets.csproj" />
  </ItemGroup>

  <!--
    The BlueMeter.Assets project is a plain class library (no Avalonia build targets),
    so its contents are not exposed as avares:// resources automatically. Link the
    image and font files into this assembly instead so they resolve under
    avares://BlueMeter/Assets/... — matching the URI scheme referenced throughout
    the ported XAML and code.
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.png" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.ico" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.jpg" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Fonts\**\*.ttf" Link="Assets\Fonts\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Fonts\**\*.otf" Link="Assets\Fonts\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

  <!--
    Holiday theme assets live in BlueMeter.Assets/Themes/. The Assets project is a
    plain class library (no Avalonia build targets), so its contents are not
    exposed as avares:// resources automatically. Link them into this assembly
    so the ChristmasDecorations controls can reference them via
    avares://BlueMeter/Assets/Themes/... .
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\BlueMeter.Assets\Themes\**\*.png" Link="Assets\Themes\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Themes\**\*.jpg" Link="Assets\Themes\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
