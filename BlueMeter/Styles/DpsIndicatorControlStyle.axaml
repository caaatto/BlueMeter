<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:BlueMeter.Controls"
                    xmlns:conv="using:BlueMeter.Converters">

    <conv:PercentToWidthConverter x:Key="PercentToWidthConverter" />

    <ControlTheme x:Key="{x:Type controls:DpsIndicatorControl}" TargetType="controls:DpsIndicatorControl">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="Root" Background="Transparent">
                    <!--  track  -->
                    <Border Name="PART_Track"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding IndicatorBackground}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="{TemplateBinding TrackOpacity}"
                            IsVisible="False" />

                    <!--
                        Indicator rectangle — width is driven by a MultiBinding through
                        PercentToWidthConverter(Percentage, Maximum, controlWidth).

                        The third arg reads the TemplatedParent's own Bounds.Width instead
                        of binding through the Root Grid by ElementName: template-scoped
                        ElementName lookups are unreliable in Avalonia's compiled XAML and
                        resolved to 0 here, which hid the bar's size entirely. The Grid
                        fills the control so TemplatedParent.Bounds.Width matches what
                        Root.Bounds.Width would have reported.

                        Width smoothing is handled by the Transitions block below — any
                        time the MultiBinding recomputes Width (Percentage change, control
                        resize, Maximum change), Avalonia tweens from the previous value.
                        The earlier port routed this through an intermediate
                        AnimatedPercentage property with an imperative Animation.RunAsync,
                        which wrote at Animation priority but never caused the MultiBinding
                        to re-evaluate Width smoothly — animating the Rectangle's Width
                        directly is simpler and is Avalonia's canonical "tween a bound
                        dimension" pattern.
                    -->
                    <Rectangle Name="PART_Indicator"
                               Height="{TemplateBinding Height}"
                               HorizontalAlignment="Left"
                               Fill="{TemplateBinding IndicatorForeground}"
                               Opacity="{TemplateBinding TrackOpacity}"
                               RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                               RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}">
                        <Rectangle.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width"
                                                  Duration="0:0:0.3"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Rectangle.Transitions>
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                <Binding Path="Percentage" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="Bounds.Width" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>

                    <ContentPresenter Name="PART_Overlay"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding OverlayContent}"
                                      ContentTemplate="{TemplateBinding OverlayTemplate}"
                                      IsHitTestVisible="False" />

                    <!--  Popup shown on hover  -->
                    <Popup Name="PART_Popup"
                           IsHitTestVisible="False"
                           IsLightDismissEnabled="False"
                           Placement="Pointer"
                           PlacementTarget="{Binding ElementName=Root}">
                        <Border MaxWidth="360"
                                Padding="6"
                                Background="#CC202020"
                                BorderThickness="0"
                                CornerRadius="4"
                                BoxShadow="0 2 10 0 #4D000000"
                                IsHitTestVisible="False">
                            <ContentControl Content="{Binding PopupContent, RelativeSource={RelativeSource TemplatedParent}}"
                                            ContentTemplate="{Binding PopupTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                            IsHitTestVisible="False" />
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!--  Hover: reveal the track and open the popup  -->
        <Style Selector="^:pointerover /template/ Border#PART_Track">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Popup#PART_Popup">
            <Setter Property="IsOpen" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
