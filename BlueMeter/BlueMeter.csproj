<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BlueMeter</AssemblyName>
    <RootNamespace>BlueMeter</RootNamespace>
    <Version>1.5.6</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Xaml.Behaviors" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Observable" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Tesseract" />
    <PackageReference Include="OxyPlot.Core" />
    <PackageReference Include="OxyPlot.Avalonia" />
    <PackageReference Include="Ihon.ResXKeyCodeGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <ClassNamePostfix>Keys</ClassNamePostfix>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-CN.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.pt-BR.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueMeter.Core\BlueMeter.Core.csproj" />
    <ProjectReference Include="..\BlueMeter.Assets\BlueMeter.Assets.csproj" />
  </ItemGroup>

  <!--
    The BlueMeter.Assets project is a plain class library (no Avalonia build targets),
    so its contents are not exposed as avares:// resources automatically. Link the
    image and font files into this assembly instead so they resolve under
    avares://BlueMeter/Assets/... — matching the URI scheme referenced throughout
    the ported XAML and code.
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.png" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.ico" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Images\**\*.jpg" Link="Assets\Images\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Fonts\**\*.ttf" Link="Assets\Fonts\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.Assets\Fonts\**\*.otf" Link="Assets\Fonts\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

  <!--
    Holiday theme assets still live under BlueMeter.WPF/Assets/Themes/ (they were
    never moved into the BlueMeter.Assets class library). Link them into this
    assembly so the ChristmasDecorations controls can reference them via
    avares://BlueMeter/Assets/Themes/... . When BlueMeter.WPF is deleted in
    Phase 11, these files need to move to BlueMeter.Assets/Themes/ and this
    block must be updated to reference the new location.
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\BlueMeter.WPF\Assets\Themes\**\*.png" Link="Assets\Themes\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\BlueMeter.WPF\Assets\Themes\**\*.jpg" Link="Assets\Themes\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
